{"noir_version":"0.36.0+801c71880ecf8386a26737a5d8bb5b4cb164b2ab","hash":9309089002709572711,"abi":{"parameters":[{"name":"p","type":{"kind":"struct","path":"P","fields":[{"name":"x","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"y","type":{"kind":"integer","sign":"unsigned","width":32}}]},"visibility":"private"},{"name":"dx","type":{"kind":"integer","sign":"signed","width":32},"visibility":"private"}],"return_type":{"abi_type":{"kind":"struct","path":"P","fields":[{"name":"x","type":{"kind":"integer","sign":"unsigned","width":32}},{"name":"y","type":{"kind":"integer","sign":"unsigned","width":32}}]},"visibility":"private"},"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"70":{"source":"#[export]\nfn add(a: u32, b: u32) -> u32 {\n    touch_exports();\n    a + b\n}\n\n#[export]\nfn mix(t: (u32, bool), arr: [u16; 3]) -> (u32, bool) {\n    let (value, flag) = t;\n    let delta = if flag { arr[0] as u32 } else { arr[1] as u32 };\n    let sum = add(value, delta);\n    (sum, flag)\n}\n\nstruct P {\n    x: u32,\n    y: u32,\n}\n\n#[export]\nfn move_point(p: P, dx: i32) -> P {\n    let delta = dx as i64;\n    let next = (p.x as i64) + delta;\n    let clamped = if next < 0 { 0 } else { next as u64 };\n    P { x: clamped as u32, y: p.y }\n}\n\nfn touch_exports() {\n    if false {\n        let zero_u32 = 0 as u32;\n        let zero_u16 = 0 as u16;\n        let dummy = [zero_u16, zero_u16, zero_u16];\n        let _ = mix((zero_u32, false), dummy);\n        let _ = move_point(P { x: zero_u32, y: zero_u32 }, 0);\n    }\n}\n","path":"/Users/hopeyen/projects/code-exercises/noi/examples/demo/noir/src/lib.nr"}},"names":["move_point"],"brillig_names":["directive_integer_quotient","directive_invert"]}