{"noir_version":"0.36.0+801c71880ecf8386a26737a5d8bb5b4cb164b2ab","hash":11762327886905507580,"abi":{"parameters":[{"name":"bid","type":{"kind":"struct","path":"Order","fields":[{"name":"price","type":{"kind":"integer","sign":"unsigned","width":64}},{"name":"size","type":{"kind":"integer","sign":"unsigned","width":64}}]},"visibility":"private"},{"name":"ask","type":{"kind":"struct","path":"Order","fields":[{"name":"price","type":{"kind":"integer","sign":"unsigned","width":64}},{"name":"size","type":{"kind":"integer","sign":"unsigned","width":64}}]},"visibility":"private"},{"name":"min_size","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"}],"return_type":{"abi_type":{"kind":"boolean"},"visibility":"private"},"error_types":{}},"bytecode":"","debug_symbols":"ldLNCoQgEAfwd5lzhzL7fJVlCSsLQTTUFhbp3dfdLajwMjf/M/yEYcbDyPt17oSatIX24UHqgTmhVUgeil/JLkx9k3XMOGgzmifA1RheZbElMAnJoa3S7ZlAiQUVFtRY0ERBTXdAUnoDWYoWGVoQtMhjgpBjcELzu6BoUaBFiRbRjRPaHKK6LjCE3ggpxdydTzOUX8wI1ku+x2lVw6nr3su/E774AA==","file_map":{"70":{"source":"struct Order {\n    price: u64,\n    size: u64,\n}\n\n#[export]\nfn match_orders(bid: Order, ask: Order, min_size: u64) -> bool {\n    let price_ok = bid.price >= ask.price;\n    let bid_ok = bid.size >= min_size;\n    let ask_ok = ask.size >= min_size;\n    price_ok & bid_ok & ask_ok\n}\n\n#[export]\nfn settle_batch(filled: [u64; 3], reserve: u64) -> i64 {\n    let mut total: u64 = 0;\n    for size in filled {\n        total += size;\n    }\n\n    if total > reserve {\n        // Negative delta = need more inventory\n        (reserve as i64) - (total as i64)\n    } else {\n        ((reserve - total) as i64)\n    }\n}\n","path":"/Users/hopeyen/projects/code-exercises/noi/examples/dark-pool/noir/src/lib.nr"}},"names":["match_orders"],"brillig_names":["directive_integer_quotient"]}