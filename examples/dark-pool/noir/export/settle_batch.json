{"noir_version":"1.0.0-beta.26+40d6574f851d926f93e0c3a271bac3e6e82ac905","hash":"5583816504854509474","abi":{"parameters":[{"name":"filled","type":{"kind":"array","length":3,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"reserve","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"}],"return_type":{"abi_type":{"kind":"integer","sign":"signed","width":64},"visibility":"private"},"error_types":{"1998584279744703196":{"error_kind":"string","string":"attempt to subtract with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"52":{"source":"struct Order {\n    price: u64,\n    size: u64,\n}\n\n#[export]\nfn match_orders(bid: Order, ask: Order, min_size: u64) -> bool {\n    touch_dark_pool_exports();\n    let price_ok = bid.price >= ask.price;\n    let bid_ok = bid.size >= min_size;\n    let ask_ok = ask.size >= min_size;\n    price_ok & bid_ok & ask_ok\n}\n\n#[export]\nfn settle_batch(filled: [u64; 3], reserve: u64) -> i64 {\n    if false {\n        let dummy = Order { price: 0, size: 0 };\n        let _ = match_orders(dummy, dummy, 0);\n    }\n    let mut total: u64 = 0;\n    for size in filled {\n        total += size;\n    }\n\n    if total > reserve {\n        // Negative delta = need more inventory\n        (reserve as i64) - (total as i64)\n    } else {\n        ((reserve - total) as i64)\n    }\n}\n\nfn touch_dark_pool_exports() {\n    if false {\n        let dummy = Order { price: 0, size: 0 };\n        let filled = [0, 0, 0];\n        let _ = settle_batch(filled, 0);\n        let _ = match_orders(dummy, dummy, 0);\n    }\n}\n","path":"/Users/hopeyen/projects/personal/noi/examples/dark-pool/noir/src/lib.nr","function_locations":[{"start":122,"name":"match_orders"},{"start":375,"name":"settle_batch"},{"start":778,"name":"touch_dark_pool_exports"}]}}}