{"noir_version":"0.36.0+801c71880ecf8386a26737a5d8bb5b4cb164b2ab","hash":16948956382476892832,"abi":{"parameters":[{"name":"filled","type":{"kind":"array","length":3,"type":{"kind":"integer","sign":"unsigned","width":64}},"visibility":"private"},{"name":"reserve","type":{"kind":"integer","sign":"unsigned","width":64},"visibility":"private"}],"return_type":{"abi_type":{"kind":"integer","sign":"signed","width":64},"visibility":"private"},"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"70":{"source":"struct Order {\n    price: u64,\n    size: u64,\n}\n\n#[export]\nfn match_orders(bid: Order, ask: Order, min_size: u64) -> bool {\n    let price_ok = bid.price >= ask.price;\n    let bid_ok = bid.size >= min_size;\n    let ask_ok = ask.size >= min_size;\n    price_ok & bid_ok & ask_ok\n}\n\n#[export]\nfn settle_batch(filled: [u64; 3], reserve: u64) -> i64 {\n    let mut total: u64 = 0;\n    for size in filled {\n        total += size;\n    }\n\n    if total > reserve {\n        // Negative delta = need more inventory\n        (reserve as i64) - (total as i64)\n    } else {\n        ((reserve - total) as i64)\n    }\n}\n","path":"/Users/hopeyen/projects/code-exercises/noi/examples/dark-pool/noir/src/lib.nr"}},"names":["settle_batch"],"brillig_names":["directive_integer_quotient","directive_invert"]}